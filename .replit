modules = ["python-3.11", "python3"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["chromedriver", "chromium", "firefox", "freetype", "geckodriver", "lcms2", "libGL", "libGLU", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Hyperion Bot"

[[workflows.workflow]]
name = "Working Bot"
author = 18374188
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python vnc_browser_bot.py"

[[workflows.workflow]]
name = "Hyperion Bot"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python vnc_browser_bot.py"

[[ports]]
localPort = 34619
externalPort = 5000
